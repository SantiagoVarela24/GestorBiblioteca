@model PrestamoModel
@{
    ViewData["Title"] = "Nuevo préstamo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
  <div class="card-header">
    <i class="bi bi-plus-circle"></i> Registrar nuevo préstamo
  </div>
  <div class="card-body">

      <form asp-action="Guardar" asp-controller="Prestamo" method="post">
      <div class="row">
        <div class="mb-3 col-md-6">
            <label asp-for="NombrePersona" class="form-label"></label>
            <input asp-for="NombrePersona" type="text" class="form-control" placeholder="Ej. Santiago Varela">
            <span asp-validation-for="NombrePersona" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-6">
            <label asp-for="Telefono" class="form-label"></label>
            <input asp-for="Telefono" type="text" class="form-control">
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>
      </div>
      <div class="row">
        <div class="mb-3 col-md-6">
            <label asp-for="TituloLibro" class="form-label"></label>
            <input asp-for="TituloLibro" type="text" class="form-control" placeholder="Ej. Cien años de soledad">
            <span asp-validation-for="TituloLibro" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-6">
            <label asp-for="Autor" class="form-label"></label>
            <input asp-for="Autor" type="text" class="form-control" placeholder="Ej. Gabriel García Márquez">
            <span asp-validation-for="Autor" class="text-danger"></span>
        </div>
      </div>
      <div class="row">
        <div class="mb-3 col-md-6">
            <label asp-for="FechaPrestamo" class="form-label"></label>
            <input asp-for="FechaPrestamo" type="date" class="form-control">
            <span asp-validation-for="FechaPrestamo" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-6">
            <label asp-for="FechaDevolucion" class="form-label"></label>
            <input asp-for="FechaDevolucion" type="date" class="form-control">
            <span class="form-text">Opcional: fecha estimada de devolución.</span>
        </div>
      </div>
      <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
      <a asp-action="Listar" asp-controller="Prestamo" class="btn btn-warning">Volver a la lista</a>
    </form>

  </div>
</div>
